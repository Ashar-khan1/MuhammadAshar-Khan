{{ 'feature-product-with-popup.css' | asset_url | stylesheet_tag }}

<section class="feature-product-grid product-grid" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="product-grid__container">
    {% if section.settings.heading != blank %}
      <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="product-grid__item-main">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <div class="product-grid__item" {{ block.shopify_attributes }}>
            <div class="product-grid__item__image">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | default: product.title }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% elsif product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% endif %}
            </div>

            <button
              type="button"
              class="more-details"
              data-product-handle="{{ product.handle }}"
              style="top: {{ block.settings.hotspot_top | default: 50 }}%; left: {{ block.settings.hotspot_left | default: 50 }}%;"
              aria-label="View product details for {{ product.title }}"
            >
              <svg class="hotspot-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 0.5V9.5M0.5 5H9.5" stroke="#000000" stroke-width="1.6" stroke-linecap="square"/>
              </svg>
            </button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% comment %}
  Product Quick-View Modal Popup
{% endcomment %}
<div
  class="product-popup-modal"
  id="modal"
  data-arrow-icon="{{ 'arrow.png' | asset_url }}"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button type="button" class="close-button" aria-label="Close modal">
      <img src="{{ 'close.png' | asset_url }}" alt="Close" width="18" height="18">
    </button>
    <div class="modal-body">
      <div class="modal-body__info">
        <div class="modal-body__info__image largePopupImage">
          <img src="" alt="" width="120" height="120">
        </div>
        <div class="modal-body__info__content">
          <h3 class="modal-body__info__content__title" id="popup-product-title"></h3>
          <p class="modal-body__info__content__price" id="popup-product-price"></p>
          <div class="modal-body__info__desc" id="popup-product-description"></div>
        </div>
      </div>

      <div class="modal-body__variants-info">
        <div id="popup-colors"></div>
        <div id="popup-sizes"></div>
      </div>

      <button id="add-to-cart-btn" class="btn btn-cart" type="button">
        <span class="btn-text">Add to Cart</span>
        <span class="icon">
          <img src="{{ 'arrow-white.png' | asset_url }}" alt="" width="20" height="auto">
        </span>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'product-popup.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Products With Popup",
  "class": "product-with-popup-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Left Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products With Popup",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "hotspot_top": 54,
            "hotspot_left": 63
          }
        },
        {
          "type": "product",
          "settings": {
            "hotspot_top": 53,
            "hotspot_left": 86
          }
        },
        {
          "type": "product",
          "settings": {
            "hotspot_top": 21,
            "hotspot_left": 63
          }
        },
        {
          "type": "product",
          "settings": {
            "hotspot_top": 18,
            "hotspot_left": 72
          }
        },
        {
          "type": "product",
          "settings": {
            "hotspot_top": 22,
            "hotspot_left": 56
          }
        },
        {
          "type": "product",
          "settings": {
            "hotspot_top": 39,
            "hotspot_left": 76
          }
        }
      ]
    }
  ]
}
{% endschema %}
